# -------------------------------------------------
# 1️⃣  ไฟล์/โฟลเดอร์ของผู้ใช้ (ไม่ต้อง version)
# -------------------------------------------------
uploads/                     # รูป‑ไฟล์/เอกสารที่ผู้ใช้อัปโหลด
*.log                        # ไฟล์ log ของระบบ (อาจอยู่ในโฟลเดอร์ logs/)

# -------------------------------------------------
# 2️⃣  ค่าลับ / ไฟล์ environment
# -------------------------------------------------
.env                         # ค่าตัวแปรแวดล้อม (DB‑USER, DB‑PASS, API‑KEY ฯลฯ)
config.php                   # หากมีไฟล์คอนฟิกที่เก็บข้อมูลลับ
db.local.php                 # ไฟล์ตั้งค่า Database ส่วนตัว
includes/db.local.php        # ไฟล์ตั้งค่า Database ส่วนตัว
*.ini                        # ไฟล์ .ini ที่อาจใช้เก็บค่า config

# -------------------------------------------------
# 3️⃣  ไฟล์/โฟลเดอร์ที่สร้างโดย PHP / XAMPP
# -------------------------------------------------
session/                     # ไฟล์ session (หากเซิร์ฟเวอร์ตั้งให้เก็บเป็นไฟล์)
tmp/                         # ไฟล์ชั่วคราวของ PHP
*.sqlite                     # ฐานข้อมูล SQLite ที่อาจสร้างชั่วคราว
*.pem                        # คีย์ SSL หรือ certificate ที่เจอโดยอัตโนมัติ

# -------------------------------------------------
# 4️⃣  ไลบรารีภายนอกที่สามารถติดตั้งได้ใหม่
# -------------------------------------------------
vendor/                      # Composer (PHP)   – ติดตั้งได้ด้วย `composer install`
node_modules/                # npm / Yarn (ถ้ามี front‑end build) – `npm install`
bower_components/            # Bower (ถ้าเคยใช้)

# -------------------------------------------------
# 5️⃣  ไฟล์ของ IDE / ระบบปฏิบัติการ
# -------------------------------------------------
.idea/                       # PhpStorm / WebStorm project settings
*.sublime-project
*.sublime-workspace
.vscode/                     # VS Code workspace settings (optional)

# Windows/macOS system files
Thumbs.db
.DS_Store
ehthumbs.db
Desktop.ini

# -------------------------------------------------
# 6️⃣  ไฟล์ backup / dump ของฐานข้อมูล
# -------------------------------------------------
*.sql                        # dump ของ MySQL (ควรใช้ไฟล์ .sql ที่บันทึกไว้แยก)
*_backup.sql                 # ตัวอย่างไฟล์สำรอง

# -------------------------------------------------
# 7️⃣  ไฟล์ที่อาจเกิดจากการ build (ถ้ามี)
# -------------------------------------------------
dist/
public/build/
static/
